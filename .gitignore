# Temporary files
tmp/
temp/
*.tmp
tmpclaude-*

# Internal development files (not committed to git)
*.tmp.md
*-INTERNAL.md
tasks/
dev/

# Generated API documentation
docs/api/

# MkDocs build output (docs site is published from CI, not committed)
site/

# Camoufox cache (CI-injected, only .gitkeep committed)
.camoufox-cache/*
!.camoufox-cache/.gitkeep

# understand-anything plugin local state (per-developer knowledge graph)
# https://github.com/Lum1104/Understand-Anything
.understand-anything/

# ESLint cache (commit-stage hook only; pre-push re-lints with no cache)
.eslintcache

# npm config is per-developer. A committed .npmrc overrides every
# contributor's ~/.npmrc, because project config outranks user config —
# so pinning the default registry here is a no-op in CI while breaking
# installs behind a corporate proxy. Registry provenance is enforced by
# the resolved URLs and integrity hashes in package-lock.json instead.
.npmrc