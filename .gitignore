# Dependencies
node_modules/

# Sensitive configuration (user config files with credentials)
config.json
config.*.json
!config.json.example
# Tool config files in config/ are not credentials â€” allow them
!config/release-please/config.json
credentials.json
credentials.*.json
!credentials.json.example
*.enc
.env
.env.e2e

# Runtime data (contains sensitive budget data)
data/
data-local-test/
cache/
chrome-data/

# Logs
npm-debug.log
*.log

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.tar.gz
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Testing
coverage/
.nyc_output/
tests/e2e/fixtures/e2e-data/
