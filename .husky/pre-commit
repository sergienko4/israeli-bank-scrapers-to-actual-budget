#!/usr/bin/env sh

# Prevent MSYS from converting Unix paths to Windows paths for Docker volume mounts
export MSYS_NO_PATHCONV=1

# ── Commit-stage scope ───────────────────────────────────────────────────
# This hook answers: **are the files I am committing clean?** It checks the
# staged path set (added, copied, modified, renamed) as it is in the working
# tree, plus the cheap whole-repo checks:
#
#   type-check            src/, incremental (tsbuildinfo under
#                         node_modules/.cache/tsc), so a warm run re-checks
#                         only what changed and what depends on it.
#   lint:staged           ESLint on staged src/ TS (main config) and staged
#                         portal JS (portal-public config); cached by content.
#   lint:biome:staged     Biome on staged src/ TS.
#   lint:config-structure, lint:allow-scripts, lint:pii   whole repo, < 3s.
#
# A partially staged file is linted as it is on disk, not as staged: a bad
# staged version fixed only on disk passes here, and a clean staged version
# with an unstaged error blocks. CI judges the committed tree. The ESLint
# cache is a speed aid, never the verdict: it cannot see that a file's
# imports changed, so push and CI lint the whole tree uncached.
#
# Whole-repo checks run at push (.husky/pre-push): type-check of src/ and
# tests/, full uncached ESLint, TypeDoc validation, markdownlint, circular
# deps, coupling. Everything else runs in GitHub CI only. Every gate here
# also runs in CI; tests/hook-ci-parity.test.ts enforces that.

. "$(dirname "$0")/../config/hooks/gate-runner.sh"

echo ""
echo "🛑 COMMIT-STAGE QUALITY GATE 🛑"
echo "==========================================="

gate_init "precommit"

echo ""
echo "⚡ Running 6 commit-stage gates in parallel..."
echo ""

run_gate "1-typecheck"   "Type-checking src/"             npm run type-check
run_gate "6-eslint"      "Running ESLint (staged)"        npm run lint:staged
run_gate "6b-biome"      "Running Biome lint (staged)"    npm run lint:biome:staged
run_gate "9-configcheck" "Checking config structure"      npm run lint:config-structure
run_gate "9b-allowscripts" "Checking allowScripts pins"   npm run lint:allow-scripts
run_gate "16-pii-check"  "Checking for PII in error messages" npm run lint:pii

wait_gates \
  "1-typecheck" "6-eslint" "6b-biome" "9-configcheck" "9b-allowscripts" "16-pii-check"

echo ""
echo "==========================================="
echo "✅ ALL 6 COMMIT-STAGE GATES PASSED. COMMITTING."
echo "   Push stage (.husky/pre-push) adds: src/ + tests/ type-check,"
echo "   full uncached ESLint, TypeDoc validation, markdownlint,"
echo "   circular deps and coupling."
echo "==========================================="
