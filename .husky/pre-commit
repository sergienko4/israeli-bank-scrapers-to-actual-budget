#!/usr/bin/env sh

# Prevent MSYS from converting Unix paths to Windows paths for Docker volume mounts
export MSYS_NO_PATHCONV=1

# ── Commit-stage scope (Testing Diamond) ─────────────────────────────────
# This hook answers one question: **is the snapshot I am recording
# internally correct?** It therefore runs only the gates whose verdict can
# change from one commit to the next within a single branch — type safety,
# architecture rules, formatting, config shape, dependency install-script
# pins, and PII leakage.
#
# Whole-repo integrity gates moved to .husky/pre-push, which answers a
# different question: **is what leaves this machine correct as a whole?**
# Nothing was dropped or weakened — every gate still runs before any commit
# reaches the remote, just once per push instead of once per commit:
#
#   type-check:test / type-check:e2e  → pre-push
#   build (tsup)                      → pre-push
#   npm audit                         → pre-push (needs the network)
#   markdownlint                      → pre-push
#   circular-dependency check         → pre-push
#   coupling regression check         → pre-push
#   full uncached ESLint              → pre-push
#
# Why the split pays: the gates run in parallel, so a stage costs its
# slowest gate plus the contention between them, not the sum. Measured on
# this repo (minimum of three alternating runs, to discount ambient load):
# the old twelve-gate hook took 35s, the split hook takes 24s — a 31%
# cut on the operation performed most often. The `allowScripts` pin gate
# added later reads two JSON files and finishes far inside that floor, so
# it does not move the number.
#
# The win is 31% rather than 60% because the two tall poles, `type-check`
# and ESLint, both stay here: each has to build the TypeScript program
# before it can say anything, and that build is the floor for the stage.
# Gates cheaper than that floor were free to keep and are kept; the ones
# moved to pre-push are the ones that verify the repo as a whole rather
# than the snapshot being recorded.
#
# ESLint runs against a cache here so an unchanged file is not re-linted.
# The cache is a speed optimisation only and is never trusted as the final
# verdict: pre-push re-runs ESLint with no cache at all.
#
# Acceptance-stage gates (unit tests + coverage, Docker build, Trivy,
# Semgrep, CodeQL, mocked + Telegram E2E, TypeDoc, lychee, ESLint canaries)
# run in GitHub CI only. See docs/architecture/ci-pipeline.md and
# .github/workflows/pr.yml (job: ci-pass).

. "$(dirname "$0")/../config/hooks/gate-runner.sh"

echo ""
echo "🛑 COMMIT-STAGE QUALITY GATE 🛑"
echo "==========================================="

gate_init "precommit"

echo ""
echo "⚡ Running 6 commit-stage gates in parallel..."
echo ""

run_gate "1-typecheck"   "Type-checking src/"             npm run type-check
run_gate "6-eslint"      "Running ESLint (cached)"        npm run lint:cached
run_gate "6b-biome"      "Running Biome lint"             npm run lint:biome
run_gate "9-configcheck" "Checking config structure"      npm run lint:config-structure
run_gate "9b-allowscripts" "Checking allowScripts pins"   npm run lint:allow-scripts
run_gate "16-pii-check"  "Checking for PII in error messages" bash -c '
  # Catch interpolated PII variables in error/throw/fail messages
  # e.g., `throw new Error(\`got ${otp}\`)` or `fail(\`token: ${token}\`)`
  # Excludes: static field names like "password is missing" or "token format"
  HITS=$(grep -rn "\${password}\|\${token}\|\${otp}\|\${secret}\|\${digits}\|\${creditCard}" src/ --include="*.ts" | grep -i "throw\|Error\|fail(" || true)
  HITS2=$(grep -rn "\${.*proxy.*}" src/ --include="*.ts" | grep -i "logger\|\.info\|\.warn\|\.error" || true)
  HITS3=$(grep -rn "getLogger().info.*\${.*\.merchant\|getLogger().info.*\${.*\.amount\|getLogger().info.*\${.*\.payee\|getLogger().info.*\${.*customerName\|getLogger().info.*\${.*payeeName" src/ --include="*.ts" || true)
  ALL="${HITS}${HITS2}${HITS3}"
  if [ -n "$ALL" ]; then
    echo "PII variable interpolation detected:"
    echo "$ALL"
    exit 1
  fi
  echo "No PII detected in error messages or info logs"
'

wait_gates \
  "1-typecheck" "6-eslint" "6b-biome" "9-configcheck" "9b-allowscripts" "16-pii-check"

echo ""
echo "==========================================="
echo "✅ ALL 6 COMMIT-STAGE GATES PASSED. COMMITTING."
echo "   Push stage (.husky/pre-push) adds: test/e2e type-checks,"
echo "   build, npm audit, markdownlint, circular deps, coupling,"
echo "   and a full uncached ESLint run."
echo "==========================================="
