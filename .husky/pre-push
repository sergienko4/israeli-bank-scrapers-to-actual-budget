#!/usr/bin/env sh

# Prevent MSYS from converting Unix paths to Windows paths for Docker volume mounts
export MSYS_NO_PATHCONV=1

# ── Push-stage scope ─────────────────────────────────────────────────────
# This hook answers: **is what leaves this machine correct as a whole?**
# It runs the whole-repo checks that a staged-file commit stage cannot see:
#
#   type-check:test  every src/ and tests/ file, incremental (tsbuildinfo
#                    under node_modules/.cache/tsc).
#   type-check:e2e   tests/e2e on its own, incremental. Not covered by
#                    type-check:test: a `/// <reference lib="dom" />` in a
#                    unit test puts DOM globals into that whole program, so
#                    an e2e file using `document` passes there and fails here.
#   lint             full ESLint, no cache. The commit stage lints only the
#                    staged files, and a typed rule can fail an unchanged
#                    file when a type it uses changes; this run catches that.
#   docs:check       TypeDoc validation (`--emit none`): an exported
#                    signature that uses an unexported type fails here.
#   lint:docs, lint:circular, coupling:check   repo-wide structure checks.
#
# Moved to GitHub CI only (job in .github/workflows/pr.yml):
#   build     → build job. Same TypeScript program as type-check; adds
#               only the emit.
#   audit     → build job, plus Dependabot. Needs the network, and an
#               advisory can appear without any change to this branch.
#   TypeDoc emit → build job (`npm run docs`).
#   Unit tests + coverage, ESLint canaries, config manifest, lychee,
#   Semgrep, CodeQL, Trivy, Docker build and E2E were already CI only.

. "$(dirname "$0")/../config/hooks/gate-runner.sh"

# Deleting a remote branch (`git push origin --delete <branch>`) pushes an
# all-zero local SHA and ships no code, so there is nothing to verify.
# Reading stdin also drains it, which git expects the hook to do.
PUSHING_CODE=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) PUSHING_CODE=1 ;;
  esac
done

if [ "$PUSHING_CODE" -eq 0 ]; then
  echo "🗑️  Branch deletion only — no code to verify."
  exit 0
fi

echo ""
echo "🛑 PUSH-STAGE QUALITY GATE 🛑"
echo "==========================================="

gate_init "prepush"

echo ""
echo "⚡ Running 7 push-stage gates in parallel..."
echo ""

run_gate "1c-typecheck-test" "Type-checking src/ and tests/"      npm run type-check:test
run_gate "1d-typecheck-e2e"  "Type-checking tests/e2e"            npm run type-check:e2e
run_gate "3b-typedoc"        "Validating API docs"                npm run docs:check
run_gate "6-eslint-full"     "Running ESLint (uncached)"          npm run lint
run_gate "8-markdownlint"    "Linting markdown docs"              npm run lint:docs
run_gate "15-circular"       "Checking for circular deps in src/" npm run lint:circular
run_gate "18-coupling"       "Checking coupling regression"       npm run coupling:check

wait_gates \
  "1c-typecheck-test" "1d-typecheck-e2e" "3b-typedoc" "6-eslint-full" \
  "8-markdownlint" "15-circular" "18-coupling"

echo ""
echo "==========================================="
echo "✅ ALL 7 PUSH-STAGE GATES PASSED. PUSHING."
echo "   GitHub CI also runs: build, npm audit, TypeDoc emit,"
echo "   unit tests + coverage, ESLint canaries, config manifest,"
echo "   lychee, Semgrep, CodeQL, Trivy, Docker build, E2E."
echo "   See .github/workflows/pr.yml (job: ci-pass)."
echo "==========================================="
