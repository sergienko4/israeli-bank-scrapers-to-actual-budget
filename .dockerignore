# Allowlist: send the daemon only what the Dockerfile copies. Everything else
# (tests, docs, local dist/, .env files, config.json with secrets) stays out.
# A Dockerfile with a sibling <name>.dockerignore uses that file instead.
# tests/deployment/DockerImageLayout.test.ts fails if a COPY source is missing.
*

!package.json
!package-lock.json
!tsconfig.json
!src/
!config/camoufox-pin.json
!config/tsc-strict-src.sh
!scripts/camoufox-fetch.mjs
!scripts/camoufox-pin-logic.mjs
!scripts/camoufox-pinned-fetcher.mjs
!.camoufox-cache/

# OS litter inside the re-included directories.
**/.DS_Store
